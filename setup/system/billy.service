[Unit]
Description=Billy Bass Assistant
After=network.target sound.target

[Service]
User=pi
Environment=PYTHONUNBUFFERED=1
# PortAudio raises its capture callback thread to real-time priority, but a
# systemd unit cannot unless the limits allow it. Without these the same
# microphone that records cleanly from a shell glitches inside the service -
# measured at ~0.7 dropouts per second of speech versus ~0.04 standalone -
# and PortAudio reports no overflow, so nothing in the logs shows it.
LimitRTPRIO=95
LimitMEMLOCK=infinity
WorkingDirectory=/home/pi/billy-b-assistant
ExecStart=/home/pi/billy-b-assistant/venv/bin/python /home/pi/billy-b-assistant/main.py
Restart=always

[Install]
WantedBy=multi-user.target
